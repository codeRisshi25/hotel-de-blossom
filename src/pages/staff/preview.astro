---
import StaffLayout from "../../layouts/StaffLayout.astro";
---
<StaffLayout title="Dashboard preview">
  <main class="min-h-screen bg-[var(--champagne)] text-[var(--charcoal)] lg:flex">
    <aside class="hidden h-screen w-[278px] shrink-0 flex-col bg-[var(--night)] px-5 py-6 lg:flex">
      <div class="flex items-center gap-3"><img src="/images/logo-optimized.png" width="42" height="42" alt="Hotel De Blossom" class="h-9 w-9 object-contain" /><div><p class="font-[var(--font-display)] text-xl leading-4 text-[var(--ivory)]">De Blossom</p><p class="mt-1 font-mono text-[8px] uppercase tracking-[.19em] text-[var(--sandstone)]">Staff desk</p></div></div>
      <nav class="mt-12 grid gap-1"><a class="flex min-h-11 items-center gap-3 bg-[rgba(247,241,230,.12)] px-3 text-sm text-[var(--ivory)] shadow-[inset_2px_0_0_var(--gold)]" href="#overview">◌ Desk overview</a><a class="flex min-h-11 items-center gap-3 px-3 text-sm text-[rgba(255,253,248,.62)]" href="#inquiries">▤ Inquiries</a><a class="flex min-h-11 items-center gap-3 px-3 text-sm text-[rgba(255,253,248,.62)]" href="#rates">₹ Room rates</a></nav>
      <div class="mt-auto border-t border-[rgba(247,241,230,.12)] px-3 pt-5"><p class="text-sm font-semibold text-[var(--ivory)]">Ananya Sharma</p><p class="mt-1 font-mono text-[9px] uppercase tracking-[.15em] text-[var(--sandstone)]">Manager</p></div>
    </aside>
    <section class="min-w-0 flex-1">
      <header class="flex min-h-[72px] items-center justify-between border-b border-[rgba(22,56,49,.13)] bg-[rgba(255,253,248,.8)] px-5 sm:px-8"><div><p class="font-mono text-[9px] uppercase tracking-[.16em] text-[var(--gold)]">Front desk operations</p><p class="font-[var(--font-display)] text-2xl leading-6 text-[var(--forest)]">Good day, team.</p></div><span class="border border-[#b8872e66] bg-[#b8872e1f] px-3 py-2 font-mono text-[9px] uppercase tracking-[.14em] text-[#78520d]">Presentation preview</span></header>
      <div class="mx-auto max-w-[1580px] p-5 sm:p-8"><div class="mb-7 flex flex-wrap items-end justify-between gap-3"><div><p class="font-mono text-[10px] uppercase tracking-[.16em] text-[rgba(22,56,49,.6)]">Today’s reception readout</p><h1 class="mt-2 font-[var(--font-display)] text-4xl text-[var(--forest)] sm:text-5xl">Nothing important <em>gets lost.</em></h1></div><button class="min-h-10 bg-[var(--gold)] px-4 text-sm font-semibold text-[var(--night)]">Review enquiries →</button></div>
        <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4"><div class="border border-[rgba(22,56,49,.14)] bg-[var(--ivory)] p-5"><p class="font-mono text-[10px] uppercase tracking-[.16em] text-[rgba(22,56,49,.66)]">New enquiries</p><p class="mt-5 font-[var(--font-display)] text-5xl text-[var(--forest)]">12</p><p class="mt-3 text-xs text-[rgba(23,24,21,.62)]">Awaiting their first considered response.</p></div><div class="border border-[rgba(184,135,46,.65)] bg-[#fffaf0] p-5"><p class="font-mono text-[10px] uppercase tracking-[.16em] text-[rgba(22,56,49,.66)]">Unassigned</p><p class="mt-5 font-[var(--font-display)] text-5xl text-[var(--forest)]">4</p><p class="mt-3 text-xs text-[rgba(23,24,21,.62)]">New guest requests without an owner.</p></div><div class="border border-[rgba(184,135,46,.65)] bg-[#fffaf0] p-5"><p class="font-mono text-[10px] uppercase tracking-[.16em] text-[rgba(22,56,49,.66)]">Overdue follow-ups</p><p class="mt-5 font-[var(--font-display)] text-5xl text-[var(--forest)]">2</p><p class="mt-3 text-xs text-[rgba(23,24,21,.62)]">Active enquiries past their promised callback.</p></div><div class="border border-[rgba(22,56,49,.14)] bg-[var(--ivory)] p-5"><p class="font-mono text-[10px] uppercase tracking-[.16em] text-[rgba(22,56,49,.66)]">Due today</p><p class="mt-5 font-[var(--font-display)] text-5xl text-[var(--forest)]">5</p><p class="mt-3 text-xs text-[rgba(23,24,21,.62)]">Follow-ups scheduled before day close.</p></div></div>
        <div class="mt-8 grid gap-5 xl:grid-cols-[1.5fr_1fr]"><section class="border border-[rgba(22,56,49,.14)] bg-[var(--ivory)]"><div class="border-b border-[rgba(22,56,49,.12)] px-5 py-4"><p class="font-mono text-[9px] uppercase tracking-[.14em] text-[rgba(22,56,49,.58)]">Newest arrivals</p><h2 class="mt-1 font-[var(--font-display)] text-2xl text-[var(--forest)]">The enquiry desk</h2></div><div class="hidden grid-cols-[1.15fr_.75fr_.9fr_.9fr] gap-4 border-b border-[rgba(22,56,49,.12)] px-5 py-3 font-mono text-[9px] uppercase tracking-[.14em] text-[rgba(22,56,49,.56)] sm:grid"><span>Guest & request</span><span>Status</span><span>Stay</span><span>Follow-up</span></div><div class="grid grid-cols-[1.15fr_.75fr_.9fr_.9fr] items-center gap-4 border-b border-[rgba(22,56,49,.1)] px-5 py-4"><span><span class="block text-sm font-semibold text-[var(--forest)]">Riya Kapoor</span><span class="mt-1 block font-mono text-[10px] uppercase tracking-[.09em] text-[rgba(23,24,21,.57)]">HDB-2026-000184 · stay</span></span><span class="w-fit border border-[#b8872e66] bg-[#b8872e1f] px-2 py-1 font-mono text-[10px] uppercase tracking-[.12em] text-[#78520d]">new</span><span class="text-xs">14 Nov → 16 Nov</span><span class="text-xs text-red-800">Today · 4:30 PM</span></div><div class="grid grid-cols-[1.15fr_.75fr_.9fr_.9fr] items-center gap-4 px-5 py-4"><span><span class="block text-sm font-semibold text-[var(--forest)]">Arjun Mehta</span><span class="mt-1 block font-mono text-[10px] uppercase tracking-[.09em] text-[rgba(23,24,21,.57)]">HDB-2026-000183 · event</span></span><span class="w-fit border border-sky-200 bg-sky-50 px-2 py-1 font-mono text-[10px] uppercase tracking-[.12em] text-sky-800">contacted</span><span class="text-xs">Banquet enquiry</span><span class="text-xs text-[rgba(23,24,21,.64)]">Tomorrow · 10 AM</span></div></section><section class="bg-[var(--forest)] p-6 text-[var(--ivory)]"><span class="font-mono text-[10px] uppercase tracking-[.16em] text-[var(--sandstone)]">Response rhythm</span><h2 class="mt-8 font-[var(--font-display)] text-4xl leading-[.92]">Warmth is in the follow-through.</h2><p class="mt-5 text-sm leading-6 text-[rgba(255,253,248,.72)]">Prioritise unassigned new enquiries, then use follow-up dates to make every promise visible to the team.</p><div class="mt-8 border-t border-[rgba(255,253,248,.18)] pt-4 font-mono text-[10px] uppercase tracking-[.12em] text-[var(--sandstone)]">Operational, not automated</div></section></div>
      </div>
    </section>
  </main>
</StaffLayout>
