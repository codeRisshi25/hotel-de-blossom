{
  "name": "hotel-de-blossom",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,green \"npm:dev -w @hdb/api\" \"npm:dev -w @hdb/web\"",
    "build": "npm run build -w @hdb/web",
    "preview": "npm run build && npm run dev -w @hdb/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test -w @hdb/api",
    "deploy": "npm run build && npm run deploy -w @hdb/api"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
